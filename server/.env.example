# Server-only configuration. Never expose these to the React frontend.
PORT=5000
NODE_ENV=development

# Origin(s) allowed to call this API (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# Used to sign admin session JWTs. Set a long random value in production.
# If left unset in development, the server generates a temporary one at
# boot and warns in the console (sessions won't survive a restart).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Required. Standard PostgreSQL only -- never Supabase. This value must
# exist ONLY on the backend; it is never sent to or read by the frontend.
# Run `npm run db:migrate` then `npm run db:seed` after setting this.
DATABASE_URL=postgresql://user:password@localhost:5432/enoise

# Optional. Without these set, verification/resend emails are logged to
# the server console instead of actually being sent (fine for local dev).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Project E-Noise <no-reply@studify.local>"

# Base URL of the deployed frontend, used to build verification links.
CLIENT_URL=http://localhost:5173

# MQTT ingestion from ESP32 + MAX9814 nodes via HiveMQ Cloud (Phase 5).
# Leave HIVEMQ_HOST unset to run the API/dashboard without a broker — the
# server logs a warning and simply skips MQTT, which is fine for frontend
# and REST work when you don't have hardware connected yet.
# HIVEMQ_HOST=xxxxxxxx.s1.eu.hivemq.cloud
HIVEMQ_PORT=8883
# HIVEMQ_USERNAME=
# HIVEMQ_PASSWORD=

# Real-time (Phase 6). The WebSocket server shares this same HTTP server/port
# (mounted at /ws) — no separate port or extra env var needed. The frontend
# derives ws(s)://<host>/ws from VITE_API_BASE_URL automatically.

# Phase 7 ML classification microservice (Python, YAMNet — see /ml-service).
# Defaults to localhost:8001, which is what `uvicorn app:app --port 8001`
# in ml-service/ listens on. Only needs changing if you deploy it elsewhere.
# ML_SERVICE_URL=http://localhost:8001
