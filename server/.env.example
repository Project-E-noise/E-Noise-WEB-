# Project E-Noise API configuration. Copy to .env and fill in.
# Never commit .env, and never put these values in the frontend.

# --- Server ---------------------------------------------------------------
PORT=5000
# development | production | test. In production the server refuses to start
# without JWT_SECRET (32+ characters) and DATABASE_URL.
NODE_ENV=development

# Website origin(s) allowed to call the API, comma-separated. One "*" is
# allowed per entry for Vercel preview URLs, e.g.
# CORS_ORIGIN=https://enoise.vercel.app,https://enoise-*-yourname.vercel.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Address of the frontend, used to build links in emails (no trailing slash).
CLIENT_URL=http://localhost:5173

# A sensor counts as offline when it has sent nothing for this many seconds
# (default 60). The server checks every 15 s, so a dead node shows as
# offline within about SENSOR_STALE_SECONDS + 15 s.
SENSOR_STALE_SECONDS=60

# --- Login sessions -------------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Code someone must type on /register to create an ADMIN account.
# Leave empty to turn admin registration off completely.
ADMIN_SIGNUP_CODE=

# --- Database (PostgreSQL) -------------------------------------------------
# Local:  postgresql://user:password@localhost:5432/enoise
# Neon:   postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/enoise

# Only for `npm test`: a SEPARATE database whose name contains "test".
# The tests delete everything in it.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/enoise_test

# Optional: accounts created by `npm run db:seed`. Without these, local
# development uses the demo passwords from the README. In production the
# seed only creates accounts if you set the passwords here.
# SEED_ADMIN_EMAIL=admin@enoise.local
# SEED_ADMIN_PASSWORD=
# SEED_CLIENT_EMAIL=client@enoise.local
# SEED_CLIENT_PASSWORD=

# --- Email (verification and password-setup links) -----------------------
# EMAIL_PROVIDER = brevo | smtp | (empty: links are printed in this console)
# Render's free plan blocks SMTP, so use brevo there.
EMAIL_PROVIDER=
EMAIL_FROM="Project E-Noise <your-verified-sender@example.com>"
# Brevo: Settings -> SMTP & API -> API keys
BREVO_API_KEY=
# SMTP (local development only), e.g. Gmail with an app password:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- MQTT (HiveMQ Cloud) ---------------------------------------------------
# Leave HIVEMQ_HOST empty to run without sensors (REST/dashboard still work).
HIVEMQ_HOST=
HIVEMQ_PORT=8883
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=
# mqtts = TLS (HiveMQ Cloud). Use mqtt only for a local test broker on port 1883.
MQTT_PROTOCOL=mqtts

# --- ML classification service (optional) --------------------------------
# Local: http://localhost:8001   Hugging Face: https://<user>-<space>.hf.space
ML_SERVICE_URL=http://localhost:8001
# Shared secret sent as the X-API-Key header. Must match ML_API_KEY in the
# ML service. Leave empty for local development.
ML_API_KEY=
